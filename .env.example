# ReelCaster Frontend — Environment Variables
# Copy to .env.local and fill in real values. Do NOT commit .env.local.

# ----------------------------------------------------------------
# Supabase (existing)
# ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------
# BlueCaster API (existing — verify present)
# ----------------------------------------------------------------
BLUECASTER_API_URL=
BLUECASTER_API_KEY=

# ----------------------------------------------------------------
# Mapbox + Weather (existing)
# ----------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_OPENWEATHERMAP_API_KEY=
NEXT_PUBLIC_WINDY_API_KEY=

# ----------------------------------------------------------------
# Email (existing — Resend)
# ----------------------------------------------------------------
RESEND_API_KEY=

# ----------------------------------------------------------------
# Cron auth (existing)
# ----------------------------------------------------------------
CRON_SECRET=

# ----------------------------------------------------------------
# Stripe (pricing + paywall)
# ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Multi-currency Prices (CAD base + USD currency_option, same amounts):
# Pro Monthly $5/mo and Pro Annual $33/yr. One ID serves both currencies;
# the checkout route picks presentment currency by region.
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# ----------------------------------------------------------------
# Twilio (Phase 6 — SMS alerts)
# ----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Twilio Verify service for OTP phone verification
TWILIO_VERIFY_SID=

# ----------------------------------------------------------------
# PostHog (Phase 10 — analytics, replaces Mixpanel)
# ----------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ----------------------------------------------------------------
# Google OAuth (Phase 4)
# ----------------------------------------------------------------
# Google client ID + secret are configured in the Supabase dashboard
# (Authentication → Providers → Google). No code-level env needed.

# ----------------------------------------------------------------
# Mixpanel (LEGACY — kept for now; removed in Phase 10)
# ----------------------------------------------------------------
NEXT_PUBLIC_MIXPANEL_TOKEN=

# ----------------------------------------------------------------
# HashiCorp Vault (runtime secrets loader — src/lib/secrets.ts)
# ----------------------------------------------------------------
# Leave VAULT_ADDR blank to keep reading secrets from this file / Vercel env
# (the default fallback). Set it to switch a deployment to Vault.
VAULT_ADDR=
# Auth: on Vercel the per-request OIDC token is used automatically. For local
# dev or non-Vercel runtimes, set a static token instead (skips OIDC).
VAULT_TOKEN=
# JWT-auth role + KV v2 secret path (defaults shown).
VAULT_JWT_ROLE=reelcaster-frontend
VAULT_KV_PATH=reelcaster-frontend
# Optional non-default mounts.
VAULT_JWT_MOUNT=jwt
VAULT_KV_MOUNT=secret
# Namespace — required on HCP Vault Dedicated / Vault Enterprise (usually "admin").
VAULT_NAMESPACE=
# In-memory cache TTL per warm instance, ms (default 300000 = 5 min).
VAULT_CACHE_TTL_MS=
