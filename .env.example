# ReelCaster Frontend — Environment Variables
# Copy to .env.local and fill in real values. Do NOT commit .env.local.

# ----------------------------------------------------------------
# Supabase (existing)
# ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------
# BlueCaster API (existing — verify present)
# ----------------------------------------------------------------
BLUECASTER_API_URL=
BLUECASTER_API_KEY=

# ----------------------------------------------------------------
# Weather (existing)
# ----------------------------------------------------------------
# NEXT_PUBLIC_MAPBOX_TOKEN removed: every map is MapLibre on our own relief
# style now, so no third-party map token is needed to run the app.
NEXT_PUBLIC_OPENWEATHERMAP_API_KEY=
NEXT_PUBLIC_WINDY_API_KEY=

# ----------------------------------------------------------------
# Email (existing — Resend)
# ----------------------------------------------------------------
RESEND_API_KEY=

# ----------------------------------------------------------------
# Cron auth (existing)
# ----------------------------------------------------------------
CRON_SECRET=

# ----------------------------------------------------------------
# Stripe (pricing + paywall)
# ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# The one Price: Pro Annual $33/yr, multi-currency (CAD base + a USD
# currency_option at the same amount), so one ID serves both and the checkout
# route picks presentment currency by region. Unset = nothing is sellable.
# (The old STRIPE_MONTHLY_PRICE_ID is gone — monthly is no longer sold. Existing
# monthly subscribers keep billing on their Price with no ID needed here.)
STRIPE_ANNUAL_PRICE_ID=

# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY above also drives the in-page Apple Pay /
# Google Pay buttons in the upgrade modal. Apple Pay additionally needs each
# host registered under Stripe → Settings → Payments → Apple Pay; on an
# unregistered domain (including localhost) the button simply doesn't render.

# ----------------------------------------------------------------
# Twilio (Phase 6 — SMS alerts)
# ----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Twilio Verify service for OTP phone verification
TWILIO_VERIFY_SID=

# ----------------------------------------------------------------
# PostHog (Phase 10 — analytics, replaces Mixpanel)
# ----------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ----------------------------------------------------------------
# Google OAuth (Phase 4)
# ----------------------------------------------------------------
# Google client ID + secret are configured in the Supabase dashboard
# (Authentication → Providers → Google). No code-level env needed.

# ----------------------------------------------------------------
# Mixpanel (LEGACY — kept for now; removed in Phase 10)
# ----------------------------------------------------------------
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Comma-separated Supabase user ids whose sessions are opted out of Mixpanel and
# PostHog (team accounts). A browser can also opt itself out with an rc_internal=1
# cookie. See src/lib/internal-traffic.ts.
NEXT_PUBLIC_ANALYTICS_INTERNAL_USER_IDS=

# ----------------------------------------------------------------
# HashiCorp Vault (runtime secrets loader — src/lib/secrets.ts)
# ----------------------------------------------------------------
# Leave VAULT_ADDR blank to keep reading secrets from this file / Vercel env
# (the default fallback). Set it to switch a deployment to Vault.
VAULT_ADDR=
# Auth: on Vercel the per-request OIDC token is used automatically. For local
# dev or non-Vercel runtimes, set a static token instead (skips OIDC).
VAULT_TOKEN=
# JWT-auth role + KV v2 secret path (defaults shown).
VAULT_JWT_ROLE=reelcaster-frontend
VAULT_KV_PATH=reelcaster-frontend
# Optional non-default mounts.
VAULT_JWT_MOUNT=jwt
VAULT_KV_MOUNT=secret
# Namespace — required on HCP Vault Dedicated / Vault Enterprise (usually "admin").
VAULT_NAMESPACE=
# In-memory cache TTL per warm instance, ms (default 300000 = 5 min).
VAULT_CACHE_TTL_MS=

# Pay-first checkout: let a signed-out visitor buy Pro without signing up
# first. Stripe collects the email and card; the webhook provisions the
# account from customer_details.email and /billing/success signs them in.
# Set to 1 to enable. Unset = signed-out buyers go to /plans/checkout as before.
NEXT_PUBLIC_PAY_FIRST_CHECKOUT=
